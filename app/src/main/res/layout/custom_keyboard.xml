<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF1C1C1E"
    android:padding="8dp">

    <!-- 键盘切换栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp">

        <Button
            android:id="@+id/btn_keyboard_abc"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="ABC"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:background="#FF2C2C2E"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btn_keyboard_123"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="123"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:background="#FF2C2C2E"
            android:layout_margin="2dp" />

    </LinearLayout>

    <!-- 英文键盘布局 -->
    <LinearLayout
        android:id="@+id/keyboard_abc_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 第一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/key_q" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Q" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_w" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="W" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_e" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="E" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_r" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="R" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_t" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="T" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_y" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Y" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_u" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="U" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_i" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="I" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_o" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="O" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_p" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="P" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
        </LinearLayout>

        <!-- 第二行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/key_a" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="A" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_s" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="S" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_d" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="D" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_f" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="F" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_g" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="G" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_h" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="H" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_j" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="J" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_k" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="K" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_l" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="L" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
        </LinearLayout>

        <!-- 第三行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/key_z" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Z" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_x" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="X" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_c" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="C" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_v" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="V" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_b" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="B" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_n" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="N" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_m" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="M" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
        </LinearLayout>

        <!-- 第四行：空格和删除 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/key_space" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="5" android:text="空格" android:textSize="14sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_backspace" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="2" android:text="删除" android:textSize="14sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 数字键盘布局 -->
    <LinearLayout
        android:id="@+id/keyboard_123_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 第一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/key_1" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="1" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_2" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="2" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_3" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="3" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_4" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="4" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_5" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="5" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
        </LinearLayout>

        <!-- 第二行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/key_6" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="6" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_7" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="7" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_8" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="8" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_9" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="9" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_0" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="0" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
        </LinearLayout>

        <!-- 第三行：符号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/key_dot" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="." android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_dash" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="-" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_underscore" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="_" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_slash" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="/" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_at" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="@" android:textSize="16sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
        </LinearLayout>

        <!-- 第四行：空格和删除 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/key_space_num" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="5" android:text="空格" android:textSize="14sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
            <Button android:id="@+id/key_backspace_num" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="2" android:text="删除" android:textSize="14sp" android:textColor="#FFFFFFFF" android:background="#FF2C2C2E" android:layout_margin="2dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

