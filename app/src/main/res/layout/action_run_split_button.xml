<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginEnd="4dp">

    <!-- 主运行按钮 -->
    <LinearLayout
        android:id="@+id/btn_run_main"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:background="@drawable/split_button_left_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_run_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_run"
            app:tint="#4EC9B0" />

        <TextView
            android:id="@+id/tv_run_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="运行"
            android:textColor="#4EC9B0"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 下拉按钮 -->
    <LinearLayout
        android:id="@+id/btn_run_dropdown"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/split_button_right_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_run_dropdown"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_dropdown"
            app:tint="#4EC9B0" />

    </LinearLayout>

</LinearLayout>
