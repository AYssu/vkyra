<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/terminal_control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    
    <!-- Terminal View -->
    <com.termux.view.TerminalView
        android:id="@+id/terminal_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF000000"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Terminal Control Bar -->
    <LinearLayout
        android:id="@+id/terminal_control_bar_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:padding="4dp">

        <!-- First row of control text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="6">

            <TextView
                android:id="@+id/btn_esc"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Esc"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_tab"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Tab"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Home"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_up"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="↑"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_end"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="End"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_menu"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="⋯"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:layout_margin="1dp" />

        </LinearLayout>

        <!-- Second row of control text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="6">

            <TextView
                android:id="@+id/btn_ctrl"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Ctrl"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_alt"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Alt"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_left"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="←"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_bottom"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="↓"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_right"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="→"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_margin="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/textview_press_effect" />

            <TextView
                android:id="@+id/btn_change"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="⇄"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_margin="1dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
