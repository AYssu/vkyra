<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FastScan" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#1C1B1F</item>
        <item name="android:navigationBarColor">#1C1B1F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#D0BCFF</item>
        <item name="colorOnPrimary">#381E72</item>
        <item name="colorPrimaryContainer">#4F378B</item>
        <item name="colorOnPrimaryContainer">#EADDFF</item>
        <item name="colorSecondary">#CCC2DC</item>
        <item name="colorOnSecondary">#332D41</item>
        <item name="colorSurface">#1C1B1F</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorSurfaceVariant">#49454F</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="android:colorBackground">#1C1B1F</item>
        <item name="colorOutline">#938F99</item>
        <item name="preferenceTheme">@style/PreferenceTheme.FastScan</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.FastScan.MaterialAlertDialog.Dark</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FastScan.MaterialAlertDialog.Dark</item>
    </style>

    <style name="Theme.FastScan" parent="Base.Theme.FastScan" />
    
    <!-- Terminal Activity Theme with Immersive Status Bar -->
    <style name="Theme.FastScan.Terminal" parent="Theme.FastScan">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
    
    <!-- Editor Activity Dark Theme -->
    <style name="Theme.FastScan.Editor.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#252526</item>
        <item name="android:navigationBarColor">#252526</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#569CD6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">#CCCCCC</item>
        <item name="colorSurfaceVariant">#252526</item>
        <item name="colorOnSurfaceVariant">#9E9E9E</item>
        <item name="colorOutline">#3C3C3C</item>
        <item name="actionMenuTextColor">#FFFFFF</item>
        <item name="colorControlNormal">#CCCCCC</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.FastScan.MaterialAlertDialog.Dark</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FastScan.MaterialAlertDialog.Dark</item>
    </style>
    
    <!-- Editor Activity Light Theme -->
    <style name="Theme.FastScan.Editor.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">#F5F5F5</item>
        <item name="android:navigationBarColor">#F5F5F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">#0066CC</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1E1E1E</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>
        <item name="colorOnSurfaceVariant">#666666</item>
        <item name="colorOutline">#E0E0E0</item>
        <item name="actionMenuTextColor">#1E1E1E</item>
        <item name="colorControlNormal">#666666</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.FastScan.MaterialAlertDialog.Light</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FastScan.MaterialAlertDialog.Light</item>
    </style>
    
    <!-- 保留旧名称以兼容 -->
    <style name="Theme.FastScan.Editor" parent="Theme.FastScan.Editor.Dark" />
    
    <!-- Settings Activity M3 Dark Theme -->
    <style name="Theme.FastScan.Settings" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#1C1B1F</item>
        <item name="android:navigationBarColor">#1C1B1F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#D0BCFF</item>
        <item name="colorOnPrimary">#381E72</item>
        <item name="colorPrimaryContainer">#4F378B</item>
        <item name="colorOnPrimaryContainer">#EADDFF</item>
        <item name="colorSecondary">#CCC2DC</item>
        <item name="colorOnSecondary">#332D41</item>
        <item name="colorSurface">#1C1B1F</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorSurfaceVariant">#49454F</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="android:colorBackground">#1C1B1F</item>
        <item name="colorOutline">#938F99</item>
        <item name="preferenceTheme">@style/PreferenceTheme.FastScan</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.FastScan.MaterialAlertDialog.Dark</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FastScan.MaterialAlertDialog.Dark</item>
    </style>
    
    <!-- M3 风格的 AlertDialog - 暗色 -->
    <style name="ThemeOverlay.FastScan.MaterialAlertDialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#2D2D2D</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorPrimary">#D0BCFF</item>
    </style>
    
    <!-- 独立使用的暗色对话框样式 -->
    <style name="DarkAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorSurfaceContainerHigh">#1E1E1E</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="colorPrimary">#D0BCFF</item>
        <item name="android:background">#1E1E1E</item>
        <item name="android:windowBackground">#1E1E1E</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DarkDialogBodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/DarkDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DarkDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DarkDialogButton</item>
    </style>
    
    <style name="DarkDialogBodyText" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">#CAC4D0</item>
    </style>
    
    <style name="DarkDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#D0BCFF</item>
    </style>
    
    <!-- M3 风格的 AlertDialog - 亮色 -->
    <style name="ThemeOverlay.FastScan.MaterialAlertDialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1E1E1E</item>
        <item name="colorPrimary">#0066CC</item>
    </style>
    
    <!-- 保留旧名称以兼容 -->
    <style name="ThemeOverlay.FastScan.MaterialAlertDialog" parent="ThemeOverlay.FastScan.MaterialAlertDialog.Dark" />
    
    <!-- M3 风格的 Preference 主题 -->
    <style name="PreferenceTheme.FastScan" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/PreferenceCategory.FastScan</item>
        <item name="switchPreferenceCompatStyle">@style/SwitchPreference.FastScan</item>
        <item name="android:textColorPrimary">#E6E1E5</item>
        <item name="android:textColorSecondary">#CAC4D0</item>
    </style>
    
    <style name="PreferenceCategory.FastScan" parent="Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_m3</item>
    </style>
    
    <!-- M3 风格的 Switch Preference -->
    <style name="SwitchPreference.FastScan" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_widget_switch_m3</item>
    </style>

    <!-- Sponsor avatar circle shape overlay -->
    <style name="ShapeAppearanceOverlay.Material3.Corner.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>