* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
# Retain upstream license bytes exactly as hashed in licenses/SOURCES.json.
LICENSE -text
licenses/** -text
# Bundled toolchains use Git LFS, including archives exceeding GitHub's file limit.
app/src/**/assets/*.tar.xz filter=lfs diff=lfs merge=lfs -text
app/src/main/assets/demo.apk filter=lfs diff=lfs merge=lfs -text
