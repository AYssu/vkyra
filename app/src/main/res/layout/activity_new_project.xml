<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- 顶部工具栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#121212"
        app:title="新建项目"
        app:titleTextColor="#E0E0E0"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#E0E0E0" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 项目名称 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_project_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="项目名称"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#D0BCFF"
                app:cursorColor="#D0BCFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_project_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E6E1E5"
                    android:textColorHint="#B0B0B0"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- 项目路径显示 -->
            <TextView
                android:id="@+id/tv_project_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/new_project_path_hint"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <!-- 选择模板标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="选择模板"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:letterSpacing="0.1" />

            <!-- 模板选择 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#2D2D2D"
                app:strokeWidth="1dp">

                <RadioGroup
                    android:id="@+id/rg_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/rb_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="空文件夹"
                        android:textColor="#E6E1E5"
                        android:buttonTint="#D0BCFF" />

                    <RadioButton
                        android:id="@+id/rb_cpp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="C++ 示例"
                        android:textColor="#E6E1E5"
                        android:buttonTint="#D0BCFF"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rb_c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="C 示例"
                        android:textColor="#E6E1E5"
                        android:buttonTint="#D0BCFF" />

                    <RadioButton
                        android:id="@+id/rb_ndk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="NDK 项目"
                        android:textColor="#E6E1E5"
                        android:buttonTint="#D0BCFF" />

                    <RadioButton
                        android:id="@+id/rb_make"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Make 项目"
                        android:textColor="#E6E1E5"
                        android:buttonTint="#D0BCFF" />

                    <RadioButton
                        android:id="@+id/rb_cmake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="CMake 项目"
                        android:textColor="#E6E1E5"
                        android:buttonTint="#D0BCFF" />

                </RadioGroup>

            </com.google.android.material.card.MaterialCardView>

            <!-- 其他选项 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="其他选项"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:letterSpacing="0.1" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#2D2D2D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Git 初始化选项 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="初始化为 Git 仓库"
                            android:textColor="#E6E1E5"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_git_init"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            app:thumbTint="#D0BCFF"
                            app:trackTint="#49454F" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#2D2D2D" />

                    <!-- README 选项 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="创建 README.md"
                            android:textColor="#E6E1E5"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_readme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="#D0BCFF"
                            app:trackTint="#49454F" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 底部按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="32dp"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="取消"
                    android:textColor="#D0BCFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="创建项目"
                    android:backgroundTint="#D0BCFF"
                    android:textColor="#1E1E1E" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
