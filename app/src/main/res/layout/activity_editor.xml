<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditorActivity">

    <!-- 主内容区域（包含侧边栏容器） -->
    <FrameLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <!-- 顶部工具栏 -->

        <!-- 编辑器区域 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurfaceVariant"
            app:iconTint="?attr/colorOnSurface"
            app:menu="@menu/editor_menu"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title=""
            app:titleTextColor="?attr/colorOnSurface">
            
            <!-- 自定义标题区域（支持下拉图标） -->
            <LinearLayout
                android:id="@+id/title_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless">
                
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="untitled.cpp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxWidth="180dp"
                    android:ellipsize="middle"
                    android:singleLine="true" />
                
                <ImageView
                    android:id="@+id/iv_dropdown"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_dropdown"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurface" />
                    
            </LinearLayout>
            
        </com.google.android.material.appbar.MaterialToolbar>

        <io.github.rosemoe.sora.widget.CodeEditor
            android:id="@+id/code_editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 查找替换栏 -->
        <LinearLayout
            android:id="@+id/find_replace_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurfaceVariant"
            android:visibility="gone"
            android:padding="8dp">
            
            <!-- 查找行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <EditText
                    android:id="@+id/et_find"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:hint="查找"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/edit_text_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:inputType="text" />
                
                <TextView
                    android:id="@+id/tv_find_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0/0"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:minWidth="40dp"
                    android:gravity="center" />
                
                <ImageButton
                    android:id="@+id/btn_find_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_arrow_up"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="上一个"
                    app:tint="?attr/colorOnSurface" />
                
                <ImageButton
                    android:id="@+id/btn_find_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_arrow_down"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="下一个"
                    app:tint="?attr/colorOnSurface" />
                
                <ImageButton
                    android:id="@+id/btn_toggle_replace"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_replace"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="替换"
                    app:tint="?attr/colorOnSurface" />
                
                <ImageButton
                    android:id="@+id/btn_close_find"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="关闭"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
            
            <!-- 替换行（默认隐藏） -->
            <LinearLayout
                android:id="@+id/replace_row"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">
                
                <EditText
                    android:id="@+id/et_replace"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:hint="替换为"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/edit_text_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:inputType="text" />
                
                <TextView
                    android:id="@+id/btn_replace_one"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="当前"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@drawable/edit_text_bg" />
                
                <TextView
                    android:id="@+id/btn_replace_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="全部"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@drawable/edit_text_bg" />
            </LinearLayout>
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline" />

        <!-- 底部符号快捷输入栏容器 - 支持多行 -->
        <LinearLayout
            android:id="@+id/symbol_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurfaceVariant">
            
            <!-- 第一行 -->
            <HorizontalScrollView
                android:id="@+id/symbol_scroll_1"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:scrollbars="none"
                android:fillViewport="true">

                <io.github.rosemoe.sora.widget.SymbolInputView
                    android:id="@+id/symbol_input"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

            </HorizontalScrollView>
            
            <!-- 第二行（默认隐藏） -->
            <HorizontalScrollView
                android:id="@+id/symbol_scroll_2"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:scrollbars="none"
                android:fillViewport="true"
                android:visibility="gone">

                <io.github.rosemoe.sora.widget.SymbolInputView
                    android:id="@+id/symbol_input_2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

            </HorizontalScrollView>
            
            <!-- 第三行（默认隐藏） -->
            <HorizontalScrollView
                android:id="@+id/symbol_scroll_3"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:scrollbars="none"
                android:fillViewport="true"
                android:visibility="gone">

                <io.github.rosemoe.sora.widget.SymbolInputView
                    android:id="@+id/symbol_input_3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

            </HorizontalScrollView>
            
        </LinearLayout>

    </LinearLayout>

    </FrameLayout>

    <!-- 侧边文件浏览器抽屉 -->
    <LinearLayout
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:elevation="16dp">

        <!-- 顶部标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:background="?attr/colorSurfaceVariant">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="资源管理器"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <ImageButton
                android:id="@+id/btn_locate_file"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_locate"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:contentDescription="定位当前文件"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_new_file"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_add_file"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:contentDescription="新建文件"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_new_folder"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_add_folder"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:contentDescription="新建文件夹"
                app:tint="?attr/colorOnSurface" />

        </LinearLayout>

        <!-- 当前路径显示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?attr/colorSurfaceVariant">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_current_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="/storage/emulated/0"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:singleLine="true"
                android:ellipsize="start" />

        </LinearLayout>

        <!-- 文件列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/file_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/colorSurfaceVariant"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
